@page "/catalogo"
@foreach (Cafe cafe in lstCafes)
{
    <div class="flex flex-col items-center justify-center border-2 w-10vw h-10vh p-4 m-2">
    <img src="@cafe.Imagen"/>
    <h2 class="text-bold">@cafe.NombreCafe</h2>
    <p>@cafe.DescripcionCafe</p>
    <p class="text-bold text-white bg-green-600 rounded-xl p-3">@cafe.PrecioCafe Bs</p>
</div>

}

