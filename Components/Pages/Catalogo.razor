@page "/catalogo"
@using System.Net.Cache
@using sharpness_sharp.Components.UIComponents
@using sharpness_sharp.Data
@using sharpness_sharp.Data.Models
@inject ApplicationAuthDbContext _dbService

<EditForm FormName="agregar-cafe" Model="@newCafe" OnSubmit="AgregarCafe">
    <InputText @bind-Value="newCafe.Imagen" class="border-2 px-2" placeholder="Introduce la imagen del cafe"></InputText>
    <InputText @bind-Value="newCafe.NombreCafe" class="border-2 px-2" placeholder="Introduce el nombre del cafe"></InputText>
    <InputText @bind-Value="newCafe.DescripcionCafe" class="border-2 px-2" placeholder="Introduce la descripcion del cafe"></InputText>
    <InputNumber @bind-Value="newCafe.PrecioCafe" class="border-2 px-2" placeholder="Introduce el precio del cafe"></InputNumber>
    
    <button type="submit">Guardar</button>
</EditForm>

<button @onclick="MostrarMensaje">Pulsame</button>
<button @onclick="CrearUnCafe">CrearCafe</button>
<div class="grid grid-cols-4 gap-4 p-4">

    @foreach(var mensaje in lstMensajes)
    {
        //<p class="ui-btn ui-btn-primary">@mensaje</p>
        <img src="https://i.pinimg.com/236x/77/7d/95/777d956b585f7b165379490a1ecf2e4b.jpg" class="w-64 rounded-xl shadow-md" />
    }
    @foreach(var cafes in lstCafes)
    {
        <CoffeeCard Id="@cafes.Id" Imagen="@cafes.Imagen" 
        DescripcionCafe="@cafes.DescripcionCafe" 
        NombreCafe="@cafes.NombreCafe" 
        PrecioCafe="@cafes.PrecioCafe"
        EnviarNotificacionActualizacion="ActualizarProducto" EliminarCafe="EliminarProducto"></CoffeeCard>
    }
    

</div>


@code {
    private Cafe newCafe=new Cafe();

    List<string> lstMensajes=new();
    private List<Cafe> lstCafes =new List<Cafe>();

    private void MostrarMensaje()
    {
        lstMensajes.Add("No te aproveches de mi😭");
    }
    private void CrearUnCafe()
    {
        lstCafes.Add( new Cafe("https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRvVnPH3vYiCy-ppHhTHmKi_l0g09cHv9DYFQd7zWVaCA&s=10,nombreCafe=",
        "cafe agregado","Cafe agregado con boton xd",20
        ));
    }
    protected override Task OnInitializedAsync()
    { 
        lstCafes=_dbService.Cafes.ToList();
        return base.OnInitializedAsync();
    }
    private Task AgregarCafe()
    {
        _dbService.Cafes.Add(newCafe);
        _dbService.SaveChanges();
        newCafe = new Cafe();
        return Task.CompletedTask;
    }
    private Task ActualizarProducto(Cafe cafeEditado)
    {
        Cafe cafeParaEditar=_dbService.Cafes.FirstOrDefault(cafe=> cafe.Id==cafeEditado.Id);
        Console.WriteLine(cafeEditado.Id);
        //Console.WriteLine(cafeEditado.Imagen);
        Console.WriteLine(cafeEditado.NombreCafe);
        Console.WriteLine(cafeEditado.DescripcionCafe);
        Console.WriteLine(cafeEditado.PrecioCafe);
        cafeParaEditar.NombreCafe=cafeEditado.NombreCafe;
        cafeParaEditar.PrecioCafe=cafeEditado.PrecioCafe;
        cafeParaEditar.DescripcionCafe=cafeEditado.DescripcionCafe;

        _dbService.SaveChanges();

        return Task.CompletedTask;
    }
    private void EliminarProducto(int id)
    {
        Cafe? cafe = lstCafes.FirstOrDefault(c=>c.Id==id);
        if(cafe is null)
        {
            return;
        }
        _dbService.Cafes.Remove(cafe);
        _dbService.SaveChanges();
        lstCafes.Remove(cafe);
    }

}