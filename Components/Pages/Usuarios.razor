@page "/usuarios"
@using sharpness_sharp.Components.UIComponents
@using sharpness_sharp.Data
@inject ApplicationAuthDbContext _dbService


<div class="flex flex-col gap-2">
    @foreach(ApplicationUser user in lstUsuarios)
    {
        <div class="border ">
            <h2>Username: @user.UserName</h2>
            <p>Email: @user.Email</p>
            <CoffeeCard DescripcionCafe="asdasdasdasd"></CoffeeCard>
        </div>
    }
</div>

@code {
    private ApplicationUser newUser=new ApplicationUser();

    protected override Task OnInitializedAsync()
    { 
        lstUsuarios=_dbService.Users.ToList();
        return base.OnInitializedAsync();
    }
    private Task AgregarUsuarios()
    {
        _dbService.Users.Add(newUser);
        _dbService.SaveChanges();
        newUser = new ApplicationUser();
         return Task.CompletedTask;
    }
    private List<ApplicationUser> lstUsuarios = new()
    {};
    public class Usuario
    {

        public string? Nombre { get; set; }
        public string? Apellidos{ get; set; }
        public string? Email { get; set; }
        public string? Password{ get; set; }
        public string? Fecha_Nac{ get; set; }
        public string? Color_Piel{ get; set; }
        public double? Estatura{ get; set; }

        public Usuario(
            string nombre,
            string apellido,
            string email,
            string password,
            string fecha_nac,
            string color_piel,
            double estatura)
        {
            Nombre = nombre;
            Apellidos= apellido;
            Email = email;
            Password = password;
            Fecha_Nac = fecha_nac;
            Color_Piel = color_piel;
            Estatura = estatura;
        }
    }
}